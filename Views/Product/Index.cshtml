
@model List<OnlineShoppingSystem.Models.Product>

@{
    ViewData["Title"] = "Online Shopping";
}

<style>
    .page-title {
        text-align: center;
        margin: 25px 0;
        font-weight: bold;
    }

    .preference-box {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
        background: #fff;
    }

    .product-card {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 18px;
        height: 100%;
        background: white;
        transition: 0.2s;
    }

    .product-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 4px 12px #00000015;
    }

    .product-name {
        font-size: 17px;
        font-weight: 600;
        min-height: 65px;
    }

    .price {
        color: #198754;
        font-size: 20px;
        font-weight: bold;
    }

    .category {
        color: #666;
        font-size: 14px;
    }
</style>

<div class="container">


<div class="student-box">
    <h5>Student Details</h5>
    <p><strong>Name:</strong> Lavishetty Nikhilesh</p>
    <p><strong>Enrollment No:</strong> 202503103520006</p>
    <p><strong>Division:</strong> A</p>
</div>

    <h2 class="page-title">Online Shopping </h2>

    @if (!string.IsNullOrEmpty(ViewBag.CustomerName))
    {
        <div class="alert alert-success">
            Welcome, @ViewBag.CustomerName!
        </div>
    }

    <div class="preference-box">
        <h5>Customer Preferences</h5>
        <hr />

        <form asp-action="SavePreferences" method="post"
              class="row g-3">

            <div class="col-md-5">
                <label class="form-label">Customer Name</label>
                <input type="text" name="customerName"
                       class="form-control"
                       placeholder="Enter your name" required />
            </div>

            <div class="col-md-5">
                <label class="form-label">Select Category</label>
                <select name="category" class="form-select">
                    <option value="All">All Categories</option>
                    <option value="electronics">Electronics</option>
                    <option value="jewelery">Jewelery</option>
                    <option value="men's clothing">Men's Clothing</option>
                    <option value="women's clothing">Women's Clothing</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    Save
                </button>
            </div>

        </form>
    </div>

    <h4 class="mb-3">Available Products</h4>

    <div class="row g-3">

        @foreach (var p in Model)
        {
            if (ViewBag.SelectedCategory == "All" ||
                ViewBag.SelectedCategory == p.Category)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="product-card">

                        <div class="product-name">
                            @p.ProductName
                        </div>

                        <p class="category">
                            Category: @p.Category
                        </p>

                        <p class="mb-1">
                            Product ID: @p.ProductId
                        </p>

                        <p class="text-secondary mb-1">
    Original Price: ₹@p.Price.ToString("0.00")
</p>

                        <p class="text-success mb-3">
                            Discount: @p.DiscountPercentage%
                        </p>

                        <div class="price mb-3">
    ₹@p.GetDiscountedPrice().ToString("0.00")
</div>

                        <div class="d-flex gap-2">
                            <a asp-action="Details"
                               asp-route-productId="@p.ProductId"
                               class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>

                            <a asp-action="Order"
                               asp-route-productId="@p.ProductId"
                               class="btn btn-success btn-sm">
                                Order Now
                            </a>
                        </div>

                    </div>
                </div>
            }
        }

    </div>
</div>
